# Database Configuration
POSTGRES_DB=tracker_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/tracker_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT Configuration
# Generate a secure secret for production using: openssl rand -hex 64
JWT_SECRET=ma5ae3ae15600100f08d386259c14228b58cf9778e336adb61ce47835e473dad115a1138bd1ee005868199fdafec44293
JWT_EXPIRATION=86400000

# Admin bootstrap (#74): /auth/register can no longer request ADMIN — this is the only way
# to provision one. Leave disabled unless email+password are also set.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Hibernate Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Redis (backs the Gateway rate limiter — use "localhost" when running the gateway outside Docker)
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# Rate limiting (token bucket: CAPACITY tokens refilled every PERIOD seconds)
RL_ACTIVITY_CAPACITY=100
RL_ACTIVITY_PERIOD=60
RL_GAMIFICATION_CAPACITY=100
RL_GAMIFICATION_PERIOD=60
RL_AUTH_CAPACITY=10
RL_AUTH_PERIOD=60

# Environment
ENVIRONMENT=development
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

#Zipkin Configuration
ZIPKIN_BASE_URL=http://localhost:9411

# AI weekly coaching digest (issue #65). Leave disabled unless a local model backend is running --
# CI has neither, and the compose health gate must stay green either way (the endpoint still
# returns all its numbers with the flag off, just no narrative).
INSIGHTS_ENABLED=false
# none | ollama | openai. This is what actually turns a backend on -- INSIGHTS_ENABLED alone does not.
# "openai" here means any OpenAI-compatible local server (Docker Model Runner, vLLM, LocalAI), not
# the hosted OpenAI API.
INSIGHTS_CHAT_PROVIDER=none

# Ollama backend (docker compose --profile insights up)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Docker Model Runner / other OpenAI-compatible backend
# (docker compose -f docker-compose.yml -f docker-compose.insights-dmr.yml up)
INSIGHTS_OPENAI_BASE_URL=http://localhost:12434/engines/v1
INSIGHTS_OPENAI_API_KEY=not-needed
INSIGHTS_OPENAI_MODEL=ai/gemma3

# Natural-language activity logging (issue #70). Leave disabled unless a local model backend is
# running -- same reasoning as INSIGHTS_ENABLED above. Uses the same INSIGHTS_CHAT_PROVIDER /
# OLLAMA_* / INSIGHTS_OPENAI_* backend settings above; there is no separate backend selector.
NATURAL_LOG_ENABLED=false
NATURAL_LOG_MAX_INPUT_CHARS=500